# Copia este archivo a ".env" (misma carpeta que los docker-compose*.yml) y rellena los valores.
# Docker Compose lo lee automáticamente para sustituir ${VARIABLE} en los compose.
# NO subas tu .env real al repositorio (ya está en .gitignore).

# --- Asistente IA (ep. 15) ---
# Activa el LLM. false = arranca sin clave y el asistente responde "desactivado".
LLM_ENABLED=false

# Modelo de Anthropic. Haiku es el más económico (recomendado para pruebas).
# Otros: claude-sonnet-4-5 (más capaz, más caro).
LLM_MODEL=claude-haiku-4-5

# Tu clave de Anthropic (solo necesaria si LLM_ENABLED=true).
ANTHROPIC_API_KEY=
